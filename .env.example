# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# Hugging Face repo IDs the notebooks pull checkpoints/data from
HF_CHECKPOINTS_REPO=<hf-username>/judgejack-judge-checkpoints
HF_DATA_REPO=<hf-username>/judgejack-pilot-data

# GitHub account this checkout/fork pushes to
GITHUB_USERNAME=<your-github-username>

# Author/branch-owner handle (e.g. used in judgejack-prm800k-<handle> branch names)
AUTHOR_HANDLE=<your-name>
